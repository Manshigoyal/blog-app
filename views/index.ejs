<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>My Blog App</title>

    <!-- BOOTSTRAP CSS -->

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <!-- CUSTOM CSS -->

    <style>

        body {

            background-color: #121212;

            color: white;

            font-family: Arial, sans-serif;

        }

        .navbar {

            box-shadow: 0px 2px 10px rgba(0,0,0,0.5);

        }

        .blog-card {

            border: none;

            border-radius: 15px;

            overflow: hidden;

            transition: 0.3s;

            box-shadow: 0px 4px 15px rgba(0,0,0,0.4);

            background: #1e1e1e;

            color: white;

        }

        .blog-card:hover {

            transform: translateY(-5px);

        }

        .blog-image {

            height: 250px;

            object-fit: cover;

        }

        .card-body {

            padding: 20px;

        }

        .btn-custom {

            border-radius: 30px;

        }

        .empty-text {

            text-align: center;

            margin-top: 100px;

            color: #bbbbbb;

        }

        .comment-box {

            background-color: #2a2a2a;

            border-radius: 10px;

            padding: 10px;

            margin-top: 10px;

        }

        .posted-date {

            font-size: 14px;

            color: #bbbbbb;

        }

        .search-box {

            width: 250px;

        }

        .form-control {

            background-color: #2a2a2a;

            color: white;

            border: 1px solid #444;

        }

        .form-control::placeholder {

            color: #bbbbbb;

        }

        .form-control:focus {

            background-color: #2a2a2a;

            color: white;

            border-color: #0d6efd;

            box-shadow: none;

        }

        @media(max-width: 768px) {

            .search-box {

                width: 100%;

            }

            .navbar .d-flex {

                flex-direction: column;

                width: 100%;

            }

        }

    </style>

</head>

<body>


<!-- NAVBAR -->

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">

    <div class="container">

        <!-- LOGO -->

        <a class="navbar-brand fw-bold" href="/">

            My Blog App

        </a>


        <!-- MOBILE TOGGLE -->

        <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarContent"
        >

            <span class="navbar-toggler-icon"></span>

        </button>


        <!-- NAVBAR CONTENT -->

        <div
            class="collapse navbar-collapse"
            id="navbarContent"
        >

            <div class="ms-auto d-flex align-items-center gap-2 mt-3 mt-lg-0">

                <!-- SEARCH FORM -->

                <form
                    class="d-flex"
                    action="/search"
                    method="GET"
                >

                    <input
                        type="search"
                        name="q"
                        class="form-control me-2 search-box"
                        placeholder="Search blogs..."
                        required
                    >

                    <button
                        class="btn btn-outline-light"
                        type="submit"
                    >

                        Search

                    </button>

                </form>


                <!-- ADD BLOG -->

                <a
                    href="/add"
                    class="btn btn-primary btn-custom"
                >

                    Add Blog

                </a>


                <!-- LOGOUT -->

                <a
                    href="/logout"
                    class="btn btn-danger btn-custom"
                >

                    Logout

                </a>

            </div>

        </div>

    </div>

</nav>


<!-- MAIN CONTAINER -->

<div class="container mt-5">


    <!-- EMPTY MESSAGE -->

    <% if(blogs.length === 0) { %>

        <div class="empty-text">

            <h2>No Blogs Available</h2>

            <p>Add your first blog now</p>

        </div>

    <% } %>


    <!-- BLOG ROW -->

    <div class="row">

        <% blogs.forEach(blog => { %>

            <div class="col-md-6 col-lg-4 mb-4">

                <div class="card blog-card h-100">


                    <!-- BLOG IMAGE -->

                    <img
                        src="/uploads/<%= blog.image %>"
                        class="card-img-top blog-image"
                        alt="Blog Image"
                    >


                    <!-- CARD BODY -->

                    <div class="card-body d-flex flex-column">


                        <!-- CATEGORY -->

                        <span class="badge bg-primary mb-3 px-3 py-2">

                            <%= blog.category %>

                        </span>


                        <!-- BLOG TITLE -->

                        <h3 class="card-title mb-3">

                            <%= blog.title %>

                        </h3>


                        <!-- AUTHOR -->

                        <div class="d-flex align-items-center gap-2 mb-3">

                            <img
                                src="/uploads/default.png"
                                width="40"
                                height="40"
                                style="border-radius: 50%; object-fit: cover;"
                            >

                            <p class="text-info m-0">

                                Written by <%= blog.author %>

                            </p>

                        </div>


                        <!-- BLOG CONTENT -->

                        <p class="card-text mb-4">

                            <%= blog.content %>

                        </p>


                        <!-- DATE -->

                        <p class="posted-date">

                            Posted on
                            <%= new Date(blog.createdAt).toDateString() %>

                        </p>


                        <!-- BUTTONS -->

                        <div class="mt-auto mb-3 d-flex gap-2 flex-wrap">

                            <!-- EDIT -->

                            <a
                                href="/edit/<%= blog._id %>"
                                class="btn btn-warning btn-custom"
                            >

                                Edit

                            </a>


                            <!-- DELETE -->

                            <a
                                href="/delete/<%= blog._id %>"
                                class="btn btn-danger btn-custom"
                            >

                                Delete

                            </a>


                            <!-- LIKE -->

                            <a
                                href="/like/<%= blog._id %>"
                                class="btn btn-primary btn-custom"
                            >

                                 Like (<%= blog.likes %>)

                            </a>

                        </div>


                        <!-- COMMENT FORM -->

                        <form
                            action="/comment/<%= blog._id %>"
                            method="POST"
                        >

                            <input
                                type="text"
                                name="comment"
                                class="form-control mb-2"
                                placeholder="Write a comment..."
                                required
                            >

                            <button
                                type="submit"
                                class="btn btn-success btn-sm"
                            >

                                Add Comment

                            </button>

                        </form>


                        <!-- COMMENTS -->

                        <div class="mt-3">

                            <% if(blog.comments.length > 0) { %>

                                <h6 class="fw-bold">

                                    Comments:

                                </h6>

                            <% } %>


                            <!-- COMMENT LOOP -->

                            <% blog.comments.forEach(comment => { %>

                                <div class="comment-box">

                                    <%= comment.text %>

                                </div>

                            <% }) %>

                        </div>

                    </div>

                </div>

            </div>

        <% }) %>

    </div>

</div>


<!-- FOOTER -->

<footer class="bg-dark text-center text-light py-3 mt-5">

    © 2026 My Blog App | Developed by Manshi

</footer>


<!-- BOOTSTRAP JS -->

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>