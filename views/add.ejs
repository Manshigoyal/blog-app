<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Add Blog</title>

    <!-- BOOTSTRAP CSS -->

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <!-- CUSTOM CSS -->

    <style>

        body {

            background-color: #121212;

            color: white;

            font-family: Arial, sans-serif;

        }

        .navbar {

            box-shadow: 0px 2px 10px rgba(0,0,0,0.5);

        }

        .blog-form-card {

            background-color: #1e1e1e;

            border: none;

            border-radius: 15px;

            box-shadow: 0px 4px 15px rgba(0,0,0,0.4);

        }

        .form-control {

            background-color: #2a2a2a;

            color: white;

            border: 1px solid #444;

        }

        .form-control:focus {

            background-color: #2a2a2a;

            color: white;

            border-color: #0d6efd;

            box-shadow: none;

        }

        .form-control::placeholder {

            color: #bbbbbb;

        }

        .form-select {

            background-color: #2a2a2a;

            color: white;

            border: 1px solid #444;

        }

        .form-select:focus {

            background-color: #2a2a2a;

            color: white;

            border-color: #0d6efd;

            box-shadow: none;

        }

        textarea {

            resize: none;

        }

        .btn-custom {

            border-radius: 30px;

            padding-left: 20px;

            padding-right: 20px;

        }

    </style>

</head>

<body>


<!-- NAVBAR -->

<nav class="navbar navbar-dark bg-dark">

    <div class="container">

        <a class="navbar-brand fw-bold" href="/">

            My Blog App

        </a>

    </div>

</nav>


<!-- MAIN CONTAINER -->

<div class="container mt-5">

    <div class="card blog-form-card p-4">

        <!-- HEADING -->

        <h1 class="text-center mb-4 text-white">

            Add New Blog

        </h1>


        <!-- FORM -->

        <form
            action="/add"
            method="POST"
            enctype="multipart/form-data"
        >

            <!-- BLOG TITLE -->

            <div class="mb-3">

                <label class="form-label">

                    Blog Title

                </label>

                <input
                    type="text"
                    name="title"
                    class="form-control"
                    placeholder="Enter Blog Title"
                    required
                >

            </div>


            <!-- IMAGE -->

            <div class="mb-3">

                <label class="form-label">

                    Upload Image

                </label>

                <input
                    type="file"
                    name="image"
                    class="form-control"
                    required
                >

            </div>


            <!-- CONTENT -->

            <div class="mb-3">

                <label class="form-label">

                    Blog Content

                </label>

                <textarea
                    name="content"
                    class="form-control"
                    rows="6"
                    placeholder="Write your blog content here..."
                    required
                ></textarea>

            </div>


            <!-- CATEGORY -->

            <div class="mb-4">

                <label class="form-label">

                    Category

                </label>

                <select
                    name="category"
                    class="form-select"
                    required
                >

                    <option value="">

                        Select Category

                    </option>

                    <option value="Tech">

                        Tech

                    </option>

                    <option value="Travel">

                        Travel

                    </option>

                    <option value="Food">

                        Food

                    </option>

                </select>

            </div>


            <!-- BUTTONS -->

            <div class="d-flex gap-2">

                <button
                    type="submit"
                    class="btn btn-success btn-custom"
                >

                    Save Blog

                </button>

                <a
                    href="/"
                    class="btn btn-secondary btn-custom"
                >

                    Back

                </a>

            </div>

        </form>

    </div>

</div>


<!-- FOOTER -->

<footer class="bg-dark text-center text-light py-3 mt-5">

    © 2026 My Blog App | Developed by Manshi

</footer>


<!-- BOOTSTRAP JS -->

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>