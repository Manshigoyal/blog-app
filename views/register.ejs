<!DOCTYPE html>
<html>

<head>

    <title>Register</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

</head>

<body class="bg-light">

<div class="container mt-5">

    <div class="card shadow p-4">

        <h1 class="text-center mb-4">
            Register
        </h1>

        <form
            action="/register"
            method="POST"
            enctype="multipart/form-data"
        >

            <!-- USERNAME -->

            <input
                type="text"
                name="username"
                class="form-control mb-3"
                placeholder="Username"
                required
            >

            <!-- EMAIL -->

            <input
                type="email"
                name="email"
                class="form-control mb-3"
                placeholder="Email"
                required
            >

            <!-- PASSWORD -->

            <input
                type="password"
                name="password"
                class="form-control mb-3"
                placeholder="Password"
                required
            >

            <!-- BIO -->

            <div class="mb-3">

                <label class="form-label">
                    Bio
                </label>

                <textarea
                    name="bio"
                    class="form-control"
                    placeholder="Write your bio..."
                ></textarea>

            </div>

            <!-- PROFILE IMAGE -->

            <div class="mb-3">

                <label class="form-label">
                    Profile Image
                </label>

                <input
                    type="file"
                    name="profileImage"
                    class="form-control"
                    required
                >

            </div>

            <!-- BUTTON -->

            <button class="btn btn-success w-100">

                Register

            </button>

        </form>

        <!-- LOGIN LINK -->

        <a
            href="/login"
            class="text-center mt-3 d-block"
        >

            Already have an account?

        </a>

    </div>

</div>

</body>

</html>