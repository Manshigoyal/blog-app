<!DOCTYPE html>
<html>

<head>

    <title>Register</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

</head>

<body class="bg-light">

<div class="container mt-5">

    <div class="card shadow p-4">

        <h1 class="text-center mb-4">
            Register
        </h1>

       <form action="/register" method="POST" enctype="multipart/form-data">

            <input
                type="text"
                name="username"
                class="form-control mb-3"
                placeholder="Username"
                required
            >

            <input
                type="email"
                name="email"
                class="form-control mb-3"
                placeholder="Email"
                required
            >

            <input
                type="password"
                name="password"
                class="form-control mb-3"
                placeholder="Password"
                required >

                <div class="mb-3">

    <label class="form-label">
        Bio
    </label>

    <textarea
        name="bio"
        class="form-control"
        placeholder="Write your bio..."
    ></textarea>

    <div class="mb-3">

    <label class="form-label">
        Profile Image
    </label>

    <input
        type="file"
        name="https://tse3.mm.bing.net/th/id/OIP.zcyCAKGXjZONO-SZ5r_o1wHaEK?pid=Api&P=0&h=180"
        class="form-control"
        required
    >

</div>

</div>

            <button class="btn btn-success w-100">
                Register
            </button>

        </form>

        <a
            href="/login"
            class="text-center mt-3"
        >
            Already have an account?
        </a>

    </div>

</div>

</body>
</html>